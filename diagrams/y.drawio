<mxfile>
  <diagram name="Microservices Architecture">
    <mxGraphModel dx="700" dy="500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- API Gateway -->
        <mxCell id="api_gateway" value="API Gateway" style="shape=ellipse;fillColor=#FF5722;" vertex="1" parent="1">
          <mxGeometry x="20" y="250" width="100" height="60" as="geometry" />
        </mxCell>
        <!-- Services -->
        <mxCell id="service_customer" value="Customer" style="shape=rectangle;fillColor=#4CAF50;" vertex="1" parent="1">
          <mxGeometry x="200" y="100" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="service_product" value="Product" style="shape=rectangle;fillColor=#2196F3;" vertex="1" parent="1">
          <mxGeometry x="200" y="250" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="service_order" value="Order" style="shape=rectangle;fillColor=#FFC107;" vertex="1" parent="1">
          <mxGeometry x="200" y="400" width="120" height="60" as="geometry" />
        </mxCell>
        <!-- Prometheus -->
        <mxCell id="prometheus" value="Prometheus" style="shape=ellipse;fillColor=#F44336;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="450" y="200" width="100" height="60" as="geometry" />
        </mxCell>
        <mxCell id="prometheus_arrow1" style="edgeStyle=elbowEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;elbow=horizontal;" edge="1" parent="1" source="prometheus" target="service_customer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="prometheus_arrow2" style="edgeStyle=elbowEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;elbow=horizontal;" edge="1" parent="1" source="prometheus" target="service_product">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="prometheus_arrow3" style="edgeStyle=elbowEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;elbow=horizontal;" edge="1" parent="1" source="prometheus" target="service_order">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Grafana -->
        <mxCell id="grafana" value="Grafana" style="shape=ellipse;fillColor=#673AB7;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="600" y="200" width="100" height="60" as="geometry" />
        </mxCell>
        <mxCell id="grafana_arrow" style="edgeStyle=elbowEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;elbow=horizontal;" edge="1" parent="1" source="prometheus" target="grafana">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
